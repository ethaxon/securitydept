{
	"name": "@securitydept/client",
	"version": "0.3.0-beta.4",
	"description": "Client of the SecurityDept TypeScript SDK, a layered authentication and authorization toolkit built as reusable Rust crates, a TypeScript client SDK workspace, and reference server/web apps.",
	"author": "Zhou Yeheng <root@aitiotekt.com>",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ethaxon/securitydept.git",
		"directory": "sdks/ts/packages/client"
	},
	"homepage": "https://securitydept.ethaxon.com/",
	"bugs": {
		"url": "https://github.com/ethaxon/securitydept/issues"
	},
	"keywords": [
		"securitydept",
		"auth",
		"authentication",
		"authorization",
		"oidc",
		"oauth",
		"sdk",
		"typescript",
		"token",
		"credentials"
	],
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": {
			"monorepo-tsc": "./src/index.ts",
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs"
		},
		"./web": {
			"monorepo-tsc": "./src/web/index.ts",
			"types": "./dist/web/index.d.mts",
			"import": "./dist/web/index.mjs"
		},
		"./webext": {
			"monorepo-tsc": "./src/webext/index.ts",
			"types": "./dist/webext/index.d.mts",
			"import": "./dist/webext/index.mjs"
		},
		"./server": {
			"monorepo-tsc": "./src/server/index.ts",
			"types": "./dist/server/index.d.mts",
			"import": "./dist/server/index.mjs"
		},
		"./rx": {
			"monorepo-tsc": "./src/rx/index.ts",
			"types": "./dist/rx/index.d.mts",
			"import": "./dist/rx/index.mjs"
		},
		"./test": {
			"monorepo-tsc": "./src/test/index.ts",
			"types": "./dist/test/index.d.mts",
			"import": "./dist/test/index.mjs"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsdown",
		"typecheck": "tsc -b --force"
	},
	"dependencies": {
		"@standard-schema/spec": "^1.0.0",
		"arktype": "^2.2.0",
		"es-toolkit": "^1.49.0",
		"injection-js": "^2.6.1",
		"mnemonist": "^0.40.4",
		"rxjs": "^7.8.2",
		"uuid": "^14.0.1"
	}
}
