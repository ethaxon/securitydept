{
	"name": "@securitydept/test-utils",
	"version": "0.3.0-beta.7",
	"private": true,
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": {
			"monorepo-tsc": "./src/index.ts",
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsdown",
		"test": "vitest run --config ../../vitest.package.config.ts",
		"test:watch": "vitest --config ../../vitest.package.config.ts",
		"typecheck": "tsc -b --pretty false",
		"build:dep": "pnpm run build"
	},
	"dependencies": {
		"@securitydept/client": "workspace:*"
	},
	"devDependencies": {
		"vitest": "catalog:"
	}
}
