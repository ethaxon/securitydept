{
	"name": "@securitydept/webui",
	"version": "0.3.0-beta.11",
	"description": "WebUI for SecurityDept",
	"type": "module",
	"scripts": {
		"build": "vite build",
		"dev": "vite dev",
		"dev:coordinated": "cross-env VITE_WAIT_FOR_BACKEND=1 vite dev",
		"e2e": "playwright test -c playwright.config.ts",
		"e2e:headed": "playwright test -c playwright.config.ts --headed",
		"stage": "shx rm -rf ../../webui && shx cp -r dist ../../webui",
		"test": "vitest run --config vitest.config.ts",
		"test:watch": "vitest --config vitest.config.ts",
		"typecheck": "tsc -b --pretty false",
		"build:dep": "pnpm run build"
	},
	"dependencies": {
		"@radix-ui/react-avatar": "^1.1.10",
		"@securitydept/basic-auth-context-client": "workspace:*",
		"@securitydept/basic-auth-context-client-react": "workspace:*",
		"@securitydept/client": "workspace:*",
		"@securitydept/client-react": "workspace:*",
		"@securitydept/session-context-client": "workspace:*",
		"@securitydept/session-context-client-react": "workspace:*",
		"@securitydept/token-set-context-client": "workspace:*",
		"@securitydept/token-set-context-client-react": "workspace:*",
		"@tanstack/react-form": "^1.25.0",
		"@tanstack/react-query": "catalog:",
		"@tanstack/react-router": "catalog:",
		"@tanstack/react-table": "^8.21.3",
		"clsx": "^2.1.1",
		"lucide-react": "^1.8",
		"react": "catalog:",
		"react-dom": "catalog:",
		"rxjs": "catalog:",
		"sonner": "^2.0.7",
		"tailwind-merge": "^3.3.0"
	},
	"devDependencies": {
		"@securitydept/e2e-utils": "workspace:*",
		"@tanstack/router-plugin": "catalog:",
		"cross-env": "^7.0.3",
		"vitest": "catalog:"
	}
}
